{
  "include": ["App.tsx", "index.tsx", "constants.ts", "types.ts", "vite*.ts", "api/**/*.ts", "components/**/*", "contexts/**/*", "hooks/**/*.ts", "pages/**/*.tsx", "types/**/*.ts", "utils/**/*.ts", "tests/**/*.ts", "seo/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
