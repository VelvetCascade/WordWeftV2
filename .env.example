VITE_API_BASE_URL=http://localhost:8080/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend/Render rollout switch. Keep true in normal production operation.
READER_SIGN_IN_GATE_ENABLED=true


# Server-side public SEO feed. Set in the Vercel production environment.
SEO_API_BASE_URL=https://wordweftv2.onrender.com/api
# Optional: force noindex on a non-production deployment. Vercel previews are automatic.
SEO_NOINDEX=false
