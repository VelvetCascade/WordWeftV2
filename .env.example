# Frontend / Vercel
# Leave this as /api for local desktop and phone testing; Vite proxies it to
# the local Spring service. Set the full Render /api URL in Vercel production.
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
# Server-side public SEO feed. Set in the Vercel production environment.
SEO_API_BASE_URL=https://wordweftv2.onrender.com/api
# Optional: force noindex on a non-production deployment. Vercel previews are automatic.
SEO_NOINDEX=false

# Backend / Render
SPRING_DATA_MONGODB_URI=mongodb+srv://replace_me
JWT_TOKEN=replace_with_at_least_64_random_characters
JWT_EXPIRY=2592000000
GOOGLE_CLIENT_ID=your_google_client_id_here
GMAIL_APPS_SCRIPT_URL=https://script.google.com/macros/s/replace_me/exec
FRONTEND_HOST=https://www.wordweftstudio.com
READER_SIGN_IN_GATE_ENABLED=true

# ImageKit remains the storage provider for covers, avatars, and character images.
IMAGEKIT_PUBLIC_KEY=replace_me
IMAGEKIT_PRIVATE_KEY=replace_me
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/replace_me/

# Cloudflare R2 is used only for inline chapter images and Founding Writer manuscripts.
# UPLOAD_SIGNING_SECRET must be identical in Render and the Cloudflare Worker secret.
UPLOAD_SIGNING_SECRET=replace_with_a_long_random_secret
WORKER_BASE_URL=https://wordweft-fw-uploads.replace_me.workers.dev

# Optional Founding Writer Google Sheet audit sink. Leave blank to disable it.
FCSHEET_URL=
